{
  "version": 2,
  "builds": [
    { "src": "*.php", "use": "vercel-php@0.7.1" },
    { "src": "admin/*.php", "use": "vercel-php@0.7.1" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "^/admin/([^./]+)$", "dest": "/admin/$1.php" },
    { "src": "^/([^./]+\.php.*)$", "dest": "/$1" },
    { "src": "^/$", "dest": "/index.php" },
    { "src": "^/([^./]+)$", "dest": "/$1.php" }
  ]
}
