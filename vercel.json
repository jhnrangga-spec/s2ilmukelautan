{
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*\\.php.*)", "dest": "/$1" },
    { "src": "/admin/(.*)", "dest": "/admin/$1.php" },
    { "src": "^/$", "dest": "/index.php" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
