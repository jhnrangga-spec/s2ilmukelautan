# ============================================================
# Konfigurasi Database
# ============================================================
# Driver: 'sqlite' (default, lokal) atau 'pgsql' (Supabase / PostgreSQL)
DB_DRIVER=pgsql

# ============================================================
# PostgreSQL / Supabase
# ============================================================
# Cara mengambil credentials dari Supabase:
# 1. Buka https://supabase.com/dashboard/project/<project-id>
# 2. Klik "Connect" (tombol hijau di atas) -> tab "ORMs" atau "Direct connection"
# 3. Pilih "Session pooler" atau "Direct connection"
# 4. Copy nilai Host, Port, Database, User, Password ke bawah
#
# Catatan: untuk shared hosting tanpa IPv6, gunakan "Session pooler"
# (host biasanya: aws-0-<region>.pooler.supabase.com, port 5432).
# Untuk koneksi langsung: db.<project-ref>.supabase.co, port 5432.
# ============================================================

DB_HOST=db.qrixabrmufbjnlqtaaek.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=isi-dengan-password-database-supabase-anda
